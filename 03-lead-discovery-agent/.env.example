# Copy this file to .env and fill in real values. .env is gitignored.
# Do not paste these values into chat.

# Required for scoring.
ANTHROPIC_API_KEY=

# Optional until you switch discovery.source from "osm" to "places".
# Set a QUOTA CAP in the Google Cloud console as well - that is your hard
# stop, independent of this app's budget guard.
GOOGLE_PLACES_API_KEY=

# Optional. Powers the "currently running paid ads" ability-to-pay signal.
META_AD_LIBRARY_TOKEN=

# Optional until you switch export from CSV to Sheets.
GOOGLE_SHEETS_CREDENTIALS=./service-account.json
GOOGLE_SHEETS_ID=
