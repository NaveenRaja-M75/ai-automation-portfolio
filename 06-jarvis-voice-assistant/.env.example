# Copy to .env and edit. All values are optional.

# Brain
FROST_MODEL=claude-opus-5
FROST_EFFORT=medium           # low | medium | high | xhigh | max

# Sandbox — Docker is used automatically when a daemon is reachable
FROST_SANDBOX_IMAGE=python:3.11-slim
FROST_SANDBOX_TIMEOUT=120
FROST_SANDBOX_NETWORK=0       # 1 to give sandboxed commands network access

# Voice output
FROST_TTS=edge                # edge | sapi | none
FROST_VOICE=en-GB-RyanNeural  # `edge-tts --list-voices` for the full list
FROST_TTS_RATE=+8%

# Voice input
FROST_STT_MODEL=tiny.en       # tiny.en | base.en | small.en
FROST_SILENCE_DURATION=0.4    # seconds of silence that end your turn
FROST_USE_WAKE_WORD=0         # 1 to require the wake word
FROST_WAKE_WORD=frost

# Paths
# FROST_WORKSPACE=C:\Users\naveen\Desktop\Jarvis\workspace
# FROST_AUDIT_LOG=  (default: %LOCALAPPDATA%\FROST\audit.jsonl — keep it
#                    outside the workspace so FROST cannot edit its own log)
