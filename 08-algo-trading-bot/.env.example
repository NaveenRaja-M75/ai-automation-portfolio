# Copy to .env (same folder) and fill in. .env is git-ignored; never paste keys into a chat.

# paper | testnet | live      (paper needs nothing else)
MODE=paper
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
DECISION_INTERVAL_S=15
HORIZONS_S=60,300,900
TRADE_HORIZON_S=300

# auto picks the signal with the best record; live auto requires a proven edge
PRIMARY_SIGNAL=auto

# ---- Jev ------------------------------------------------------------------------
# off | vercel | openrouter | typesafe
#   vercel:     free $5 credit every 30 days. Key from vercel.com -> AI Gateway -> API Keys
#   openrouter: prepaid credits. Key from openrouter.ai/keys
#   typesafe:   console.typesafe.ai (new signups paused since 2026-09-22)
JEV_PROVIDER=off
JEV_API_KEY=
# leave blank for the provider default; pin a version once thresholds are tuned
JEV_MODEL=
JEV_INTERVAL_S=30
JEV_DAILY_BUDGET_USD=0.16

# ---- policy ---------------------------------------------------------------------
ENTRY_PROB=0.60
EXIT_PROB=0.45
MIN_EDGE_MULTIPLE=1.5
STOP_VOL_MULTIPLE=2.0
COOLDOWN_S=60
# a "signal faded" exit needs MIN_HOLD_S held and EXIT_CONFIRM fades in a row (stops and time exits don't wait)
MIN_HOLD_S=60
EXIT_CONFIRM=2
# enter only when (2*calibrated_p - 1) * typical_move > round-trip cost. Calibrated p comes from the
# signal's MEASURED hit rate at that confidence level, so an unproven signal reads ~0.5 and cannot enter
REQUIRE_POSITIVE_EV=true

# ---- costs (Binance spot, Indian resident) --------------------------------------
FEE_PCT=0.001
APPLY_TDS=true

# ---- risk -----------------------------------------------------------------------
PAPER_EQUITY_USDT=1000
RISK_PCT=0.01
DAILY_LOSS_LIMIT_PCT=0.03
MAX_NOTIONAL_PCT=0.25
# account guards (loopholes a per-order gate can't see)
MAX_DRAWDOWN_PCT=0.05
MAX_LOSS_STREAK=3
PAUSE_AFTER_STREAK_S=3600
MAX_TRADES_PER_DAY=20
MAX_TOTAL_EXPOSURE_PCT=0.50
MAX_SPREAD_BPS=10
MAX_VOL_RATIO=3.0
MAX_SLIPPAGE_BPS=5

# ---- exchange (testnet / live only) ---------------------------------------------
# Create the key yourself with SPOT TRADING ONLY: withdrawals OFF, IP-restricted.
# testnet keys: testnet.binance.vision    live keys: binance.com -> API Management
BINANCE_API_KEY=
BINANCE_API_SECRET=
# live mode refuses to start unless this is exactly I_ACCEPT_REAL_MONEY_RISK
LIVE_CONFIRM=
# live entries need an EDGE_PLAUSIBLE scorecard for the primary signal
REQUIRE_EDGE_FOR_LIVE=true

# ---- daily paper allocation (backtest's most consistent rule) ----------------------
ALLOC_ENABLED=true
ALLOC_SYMBOLS=BTCUSDT,ETHUSDT
ALLOC_CAPITAL=1000
# extra paper books, separated by ";" (each a comma list of symbols)
ALLOC_EXTRA_BOOKS=BTCUSDT
# fifo | average  (ask your CA before changing; never switch back and forth)
ALLOC_LOT_METHOD=fifo

DASHBOARD_PORT=8766
